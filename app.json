{
  "expo": {
    "name": "VetTidy",
    "slug": "vettidy",
    "scheme": "vettidy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vettidy.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vettidy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F3D2B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "VetTidy uses your camera so you can photograph receipts, vaccination certificates, and other documents to attach to your pet's health record.",
          "photosPermission": "VetTidy uses your photo library so you can attach an existing photo to your pet's profile or health record."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F3D2B"
        }
      ]
    ]
  }
}
